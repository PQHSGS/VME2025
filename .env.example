# ============================================================================
# realtime-flow configuration
# Copy to .env and adjust. Only knobs with measurable venue impact are
# exposed here. Fixed constants (sample rate, model paths, etc.) live in
# config.py and cannot be overridden via env.
# ============================================================================

# ============================================================================
# TUNING GUIDE — read this before changing anything
# ============================================================================
#
# The knobs below are grouped by HOW OFTEN you should touch them:
#
#   SET ONCE    — change during initial setup, then lock
#   [TUNE]      — empirical; change ONE, run a show-hour, read traces
#   LEAVE ALONE — sane defaults; only change if you know why
#
# What to watch in logs/traces.jsonl per turn:
#   stages_ms   — latency breakdown (situation|answer-cache|retrieval|llm_ttft)
#   path        — which code path answered (situation|answer-cache|llm|fallback)
#   docs        — how many retrieved docs entered the prompt
#   prompt_chars — total prompt size; watch if TTFT creeps up
#
# Conversation transcripts (full user text + reply) go to:
#   logs/conversations.jsonl
#
# After changing a [TUNE] knob:
#   1. Run a 1-hour session with real visitors
#   2. python scripts/bench_latency.py   (per-stage percentiles)
#   3. python scripts/trace_summary.py   (stage breakdown + path distribution)
#   4. Compare before/after; keep the better setting
#
# ============================================================================

# ---- LLM — SET ONCE -------------------------------------------------------
# auto | gemini | mock   ("auto" is an alias for gemini)
LLM_BACKEND=auto
GEMINI_API_KEY=                      # required; also reads GOOGLE_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite   # SET ONCE: cheapest + fastest flash tier
GEMINI_THINKING_LEVEL=minimal        # SET ONCE: "minimal"=fastest TTFT
GEMINI_BASE_URL=                     # SET ONCE: regional proxy if needed

# ---- LLM — [TUNE] ---------------------------------------------------------
LLM_TEMPERATURE=0.4                  # [TUNE] lower=factual, higher=creative
LLM_MAX_TOKENS=220                   # [TUNE] shorter=faster tail, safer for kids
TTFT_FILLER_AFTER_S=1.8             # [TUNE] filler if no token by then (lower=less dead air)
TTFA_FIRST_CLAUSE=true               # [TUNE] release "Vâng," at first comma
LLM_HARD_DEADLINE_S=15               # LEAVE ALONE: abort generation past this
LLM_COOLDOWN_S=120                   # LEAVE ALONE: circuit breaker cooldown

# ---- ASR — SET ONCE -------------------------------------------------------
# gipformer-65M int8 (default): 7.87% WER FLEURS-vi, 30x realtime on CPU.
# Files: models/gipformer-65M-i8/{encoder,decoder,joiner}.int8.onnx + tokens.txt
# Legacy: set ASR_BACKEND=whisper for EraX-WoW-Turbo CT2 (14.6% WER, 0.75x RTF).
ASR_BACKEND=gipformer

# ---- TTS — SET ONCE -------------------------------------------------------
TTS_ENABLED=true
TTS_ENGINE=vienneu                   # SET ONCE: vienneu (local) | edge (cloud)
VIENEU_VOICE=Minh Đức                # SET ONCE: preset name
VIENEU_BACKEND=onnx                  # SET ONCE: onnx (CPU) | auto
TTS_VOICE=vi-VN-NamMinhNeural       # LEAVE ALONE: edge-tts fallback voice
TTS_RATE=+10%                        # LEAVE ALONE: brisk delivery
TTS_CACHE_SIZE=256                   # LEAVE ALONE: LRU of synthesized lines
TTS_IDLE_CLOSE_S=300                 # LEAVE ALONE: keep device open across gaps
TTS_MAX_CONSECUTIVE_FAILURES=3       # LEAVE ALONE: engine health gate

# ---- TTS — [TUNE] ---------------------------------------------------------
FALLBACK_REPLY=Ông chưa nghe rõ lắm, cháu nói lại giúp ông nhé!

# ---- Smart Turn — SET ONCE -------------------------------------------------
SMART_TURN_ENABLED=true              # SET ONCE: learned end-of-turn detector

# ---- Smart Turn — [TUNE] ---------------------------------------------------
SMART_TURN_THRESHOLD=0.5             # [TUNE] raise if turns cut mid-question; lower if dead air
SMART_TURN_CHECK_MS=400              # [TUNE] classify quiet pauses every N ms (>=100)
SMART_TURN_MAX_EXTRA_MS=3500         # LEAVE ALONE: hard cap for hesitant speakers

# ---- Retrieval — SET ONCE --------------------------------------------------
# Top VN-MTEB pick. CHANGING THIS => rerun: python -m rag.ingest && python scripts/bench_rag.py
EMBED_MODEL=aisingapore/SEA-LION-E5-Embedding-600M
EMBED_QUERY_PROMPT=Retrieval         # SET ONCE: E5 instruct prompt name; "" disables

# ---- Retrieval — [TUNE] ----------------------------------------------------
EMBED_THREADS=4                      # [TUNE] torch threads; 0=all cores (often slower)
CONTEXT_CHAR_BUDGET=1400             # [TUNE] char budget for retrieved text; watch prompt_chars
GATE_THRESHOLD=0.40                  # [TUNE] centroid cosine; below this = skip retrieval
RETRIEVER_TOPK_CANDIDATES=8          # LEAVE ALONE: FAISS candidate pool
RETRIEVER_FINAL_DOCS=4               # LEAVE ALONE: docs after MMR
RETRIEVER_MIN_SCORE=0.30             # LEAVE ALONE: score floor
RETRIEVER_MMR_LAMBDA=0.72            # LEAVE ALONE: relevance vs diversity mix
DEDUP_PENALTY=0.05                   # LEAVE ALONE: per recently-shown chunk
DEDUP_WINDOW_TURNS=3                 # LEAVE ALONE: how many turns back to check

# ---- Situations — [TUNE] ---------------------------------------------------
SITUATIONS_ENABLED=true
SITUATIONS_THRESHOLD=0.86            # [TUNE] scripted-answer match bar; lower=more hits

# ---- Answer Cache — [TUNE] -------------------------------------------------
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_SIMILARITY=0.92         # [TUNE] cosine bar; lower=more hits, higher=safe
ANSWER_CACHE_MAX_ENTRIES=128         # LEAVE ALONE: LRU bound
ANSWER_CACHE_TTL_MIN=240             # LEAVE ALONE: staleness bound (minutes)
ANSWER_CACHE_MIN_REPLY_CHARS=30      # LEAVE ALONE: skip short acks

# ---- Memory / Context — [TUNE] ---------------------------------------------
RECENT_EXCHANGES=4                   # [TUNE] verbatim turns in prompt
SUMMARIZE_EVERY_TURNS=6              # [TUNE] how often to summarize (higher=cheaper)
SUMMARY_MAX_CHARS=700                # LEAVE ALONE: summary truncation
SESSION_IDLE_RESET_MIN=3             # [TUNE] idle gap before fresh session (minutes)

# ---- Idle Attract Mode — [TUNE] --------------------------------------------
ATTRACT_ENABLED=true
ATTRACT_AFTER_MIN=5                  # [TUNE] minutes of quiet before inviting
ATTRACT_LINES=Ê các em ơi, muốn nghe chuyện Tết Trung Thu không? Cứ hỏi ông này!|Ông biết mọi điều về đèn ông sao, múa lân đó nha, hỏi thử xem!|Đến rồi mà im re vậy hả? Hỏi ông bất cứ điều gì về Trung Thu nhé!

# ---- Logging — LEAVE ALONE -------------------------------------------------
LOG_LEVEL=INFO
VERBOSE_CONSOLE=true
TELEMETRY_ENABLED=true               # per-turn JSONL -> logs/traces.jsonl + conversations.jsonl
